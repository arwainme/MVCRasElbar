@model List<Student>

    <h2>All Students</h2>

<table class="table">
    <thead class="thead-dark">
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Department</th>
            <th scope="col">Gpa</th>
            <th scope="col">Image</th>
        </tr>
    </thead>


    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th scope="row">@item.Id</th>
                <td>@item.Name</td>
                <td>@item.Department</td>
                <td>@item.Gpa</td>
                <td>
                    <img src="~/Images/@item.ImageUrl" alt="@item.Name" width="100px" />
                </td>   
            </tr>
        }




    </tbody>
</table>





























    
